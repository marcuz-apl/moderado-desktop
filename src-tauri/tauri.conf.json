{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moderado Desktop",
  "version": "0.2.8",
  "identifier": "com.moderado.desktop",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Moderado Desktop", "width": 1180, "height": 760, "minWidth": 760, "minHeight": 540, "maximized": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://localhost:1420 ws://localhost:1420; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
