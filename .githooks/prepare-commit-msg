#!/bin/sh
HOOKDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HOOKDIR/versionlib.sh"

msgfile=$1
[ -f "$msgfile" ] || exit 0
ver=$(read_version) || exit 1
validate_identifier "$ver"

# A feat commit is the only thing that should move the patch digit, but the
# message is not available when pre-commit stages VERSION, so it cannot be
# automatic. Point at the explicit bump instead of silently keeping the digit.
subject=$(awk '!/^#/ && NF { print; exit }' "$msgfile")
if [ "$(detect_bump_type "$subject")" = "patch" ]; then
  prev=$(git show HEAD:VERSION 2>/dev/null | tr -d '\r\n ')
  if [ -n "$prev" ] && [ "${prev%%+*}" = "${ver%%+*}" ]; then
    echo "moderado-versioning: feat commit kept ${ver%%+*}; run 'npm run version:patch' before committing to bump it." >&2
  fi
fi

tmp=$(mktemp) || exit 1
awk -v stamp="$ver" '
  !done && $0 !~ /^#/ && NF {
    sub(/^v[0-9]+\.[0-9]+\.[0-9]+[+-][0-9][0-9][0-9][0-9][0-9][0-9][0-9a-z] /, "")
    print stamp " " $0
    done = 1
    next
  }
  { print }
' "$msgfile" > "$tmp" && mv -f -- "$tmp" "$msgfile"
