#!/bin/sh
HOOKDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HOOKDIR/versionlib.sh"

msgfile=$1
[ -f "$msgfile" ] || exit 0
ver=$(read_version) || exit 1
validate_identifier "$ver"

# The patch bump is decided by scripts/commit.mjs before git runs, and
# commit-msg rejects any feat commit that skipped it. Report the bump here so
# the change is visible instead of silent. Replay pins its own identifier.
subject=$(awk '!/^#/ && NF { print; exit }' "$msgfile")
if [ -z "${MODERADO_VERSION_REPLAY:-}" ] && [ "$(detect_bump_type "$subject")" = "patch" ]; then
  prev=$(git show HEAD:VERSION 2>/dev/null | tr -d '\r\n ')
  if [ -n "$prev" ] && [ "${prev%%+*}" != "${ver%%+*}" ]; then
    echo "moderado-versioning: patch bumped to ${ver%%+*}" >&2
  fi
fi

tmp=$(mktemp) || exit 1
awk -v stamp="$ver" '
  !done && $0 !~ /^#/ && NF {
    sub(/^v[0-9]+\.[0-9]+\.[0-9]+[+-][0-9][0-9][0-9][0-9][0-9][0-9][0-9a-z] /, "")
    print stamp " " $0
    done = 1
    next
  }
  { print }
' "$msgfile" > "$tmp" && mv -f -- "$tmp" "$msgfile"
