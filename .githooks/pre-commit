#!/bin/sh
HOOKDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HOOKDIR/versionlib.sh"

old=$(read_version)
validate_identifier "$old"

# Git writes the commit message after this hook runs, so scripts/commit.mjs
# supplies the bump kind as MODERADO_BUMP_KIND=patch for feat commits. Staging
# has to happen here: index changes made in prepare-commit-msg or commit-msg
# are left staged and do not reach the commit. MODERADO_VERSION_REPLAY pins an
# exact identifier when rebuilding history (the build counter must not move).
if [ -n "${MODERADO_VERSION_REPLAY:-}" ]; then
  new=$MODERADO_VERSION_REPLAY
  validate_identifier "$new"
else
  new=$(next_identifier "$old" "$(utc_yymmdd)" "${MODERADO_BUMP_KIND:-build}") || exit 1
fi

printf '%s\n' "$new" > "$VERSION_FILE"
git add -- "$VERSION_FILE"

# VERSION is the single source of truth; every other manifest follows it.
sync_manifests "$new"
