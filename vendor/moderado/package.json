{
  "name": "moderado-vendored",
  "private": true,
  "type": "module",
  "description": "Pinned Moderado agent packages vendored from the CLI repository. Do not edit; re-run scripts/vendor-moderado.ps1 instead.",
  "workspaces": [
    "packages/contracts",
    "packages/core",
    "packages/providers",
    "packages/tools"
  ],
  "scripts": {
    "build": "tsc -b packages/contracts packages/core packages/providers packages/tools",
    "typecheck": "tsc -b packages/contracts packages/core packages/providers packages/tools --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.7.3"
  }
}