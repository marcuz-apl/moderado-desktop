{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "sourceMap": true,
    "declaration": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@moderado/contracts": ["../../vendor/moderado/packages/contracts/dist/index.d.ts"],
      "@moderado/core": ["../../vendor/moderado/packages/core/dist/index.d.ts"],
      "@moderado/providers": ["../../vendor/moderado/packages/providers/dist/index.d.ts"],
      "@moderado/tools": ["../../vendor/moderado/packages/tools/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}